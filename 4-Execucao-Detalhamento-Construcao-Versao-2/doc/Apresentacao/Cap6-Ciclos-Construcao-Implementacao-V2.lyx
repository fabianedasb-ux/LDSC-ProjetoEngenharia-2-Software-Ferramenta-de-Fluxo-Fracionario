\begin_layout Plain Layout
void MainWindow::plotarResultados() {
\end_layout

\begin_layout Plain Layout
    auto calc = simulador->getCalculadora();
\end_layout

\begin_layout Plain Layout
    auto welge = simulador->getWelge();
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    double pvi_input = ui->lePVI->text().toDouble();
\end_layout

\begin_layout Plain Layout
    double swi = obterSaturacaoInicialUI();
\end_layout

\begin_layout Plain Layout
    double sor = obterSaturacaoOleoResidualUI();
\end_layout

\begin_layout Plain Layout
    double sw_max = 1.0 - sor;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    // Executa Welge passando os parâmetros reais
\end_layout

\begin_layout Plain Layout
    welge->calcularTangente(calc,
 swi,
 sw_max);
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    double swFrente = welge->getSwFrente();
\end_layout

\begin_layout Plain Layout
    double vel_choque = welge->getInclinacaoChoque();
\end_layout

\begin_layout Plain Layout
    double t_bt = (vel_choque > 1e-6) ?
 (1.0 / vel_choque) :
 1.0;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    // -----------------------------------------------------------------
\end_layout

\begin_layout Plain Layout
    // 1.
 PERFIL DE SATURAÇÃO (Sw vs xD)
\end_layout

\begin_layout Plain Layout
    // -----------------------------------------------------------------
\end_layout

\begin_layout Plain Layout
    QVector<double> xD,
 Sw;
\end_layout

\begin_layout Plain Layout
    double pos_choque = vel_choque * pvi_input;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
	xD.append(0.0);
\end_layout

\begin_layout Plain Layout
    Sw.append(sw_max);
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    for (double s = sw_max;
 s >= swFrente;
 s -= 0.001) {
\end_layout

\begin_layout Plain Layout
        double vel = calc->calcularDerivadaFw(s);
\end_layout

\begin_layout Plain Layout
        double pos = vel * pvi_input;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
        if (pos > pos_choque) pos = pos_choque;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
        if (pos <= 1.0) {
\end_layout

\begin_layout Plain Layout
            xD.append(pos);
\end_layout

\begin_layout Plain Layout
            Sw.append(s);
\end_layout

\begin_layout Plain Layout
        }
\end_layout

\begin_layout Plain Layout
    }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    if (pos_choque <= 1.0) {
\end_layout

\begin_layout Plain Layout
        xD.append(pos_choque);
 Sw.append(swi);
\end_layout

\begin_layout Plain Layout
        xD.append(1.0);
        Sw.append(swi);
\end_layout

\begin_layout Plain Layout
    } else {
\end_layout

\begin_layout Plain Layout
        double target_vel = 1.0 / pvi_input;
\end_layout

\begin_layout Plain Layout
        double sw_out = swFrente;
\end_layout

\begin_layout Plain Layout
        for (double s = sw_max;
 s >= swFrente;
 s -= 0.001) {
\end_layout

\begin_layout Plain Layout
            if (calc->calcularDerivadaFw(s) >= target_vel) {
\end_layout

\begin_layout Plain Layout
                sw_out = s;
\end_layout

\begin_layout Plain Layout
                break;
\end_layout

\begin_layout Plain Layout
            }
\end_layout

\begin_layout Plain Layout
        }
\end_layout

\begin_layout Plain Layout
        if (!xD.isEmpty() && xD.last() < 1.0) {
\end_layout

\begin_layout Plain Layout
            xD.append(1.0);
\end_layout

\begin_layout Plain Layout
            Sw.append(sw_out);
\end_layout

\begin_layout Plain Layout
        }
\end_layout

\begin_layout Plain Layout
    }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    ui->plotSvsX->graph(0)->setData(xD,
 Sw);
\end_layout

\begin_layout Plain Layout
    ui->plotSvsX->xAxis->setRange(0.0,
 1.0);
\end_layout

\begin_layout Plain Layout
