    _rho_w = rho_w;
\end_layout

\begin_layout Plain Layout
    _rho_o = rho_o;
\end_layout

\begin_layout Plain Layout
    _k = k;
\end_layout

\begin_layout Plain Layout
    
\end_layout

\begin_layout Plain Layout
    // Transformação analítica:
 de Graus para Radianos
\end_layout

\begin_layout Plain Layout
    _angulo = angulo * (M_PI / 180.0);
\end_layout

\begin_layout Plain Layout
    _qt = qt;
\end_layout

\begin_layout Plain Layout
    _A = A;
\end_layout

\begin_layout Plain Layout
    
\end_layout

\begin_layout Plain Layout
    // Consequência cinemática imediata:
\end_layout

\begin_layout Plain Layout
    _ut = (qt / _A);
\end_layout

\begin_layout Plain Layout
}
\end_layout

\begin_layout Plain Layout

\end_layout

