\end_layout

\begin_layout Plain Layout
    for (int i = 0;
 i <= numPontos;
 ++i) {
\end_layout

\begin_layout Plain Layout
        double sw = i * passoSw;
\end_layout

\begin_layout Plain Layout
        if (sw > 1.0) sw = 1.0;
\end_layout

\begin_layout Plain Layout
        
